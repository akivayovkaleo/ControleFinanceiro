{
  "name": "controle-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "Controle financeiro pessoal e para casais — espaços compartilhados, divisão de despesas e acerto de contas.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "node scripts/setup.mjs",
    "check": "npm run typecheck && npm run test",
    "senha": "node scripts/reset-password.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "jose": "6.2.10",
    "lucide-react": "0.545.0",
    "next": "15.5.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
