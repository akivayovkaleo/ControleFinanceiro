# Copie para `.env` — ou rode `npm run setup`, que gera este arquivo
# já com um AUTH_SECRET seguro. NUNCA versione o `.env`.

# ---------------------------------------------------------------- banco
# SQLite por padrão: um arquivo, zero configuração, backup = copiar o arquivo.
# Para migrar para PostgreSQL, veja docs/DEPLOY.md.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------ segurança
# Chave de assinatura dos cookies de sessão. Precisa de 32+ caracteres.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esta chave desloga todo mundo — é o botão de emergência.
AUTH_SECRET=""

# Quantos dias uma sessão dura sem novo login.
SESSION_DAYS=30

# ------------------------------------------------------------- cadastro
# Depois que você e quem mais for usar já tiverem conta, mude para "true":
# a instalação para de aceitar novos cadastros.
DISABLE_SIGNUP=false

# Opcional: só estes e-mails podem se cadastrar (separados por vírgula).
# ALLOWED_EMAILS="voce@exemplo.com,alguem@exemplo.com"

# ---------------------------------------------------------------- outros
# Opcional: URL pública da instalação, usada para montar links.
# APP_URL="https://financeiro.seudominio.com"

# ---------------------------------------------------------------- anexos
# Onde os comprovantes ficam guardados.
#
# ATENCAO AO BACKUP: com anexos, copiar o arquivo do SQLite deixa de ser o
# backup inteiro. Esta pasta precisa ir junto, ou os lancamentos voltam
# apontando para comprovantes que nao existem mais.
ATTACHMENTS_DIR="./data/anexos"
